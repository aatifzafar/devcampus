# ================================================================
# Alliance.ai (EDUX 2.0) - Backend Configuration
# ================================================================

# Server Port
PORT=5000

# Secret used to sign JWT authentication tokens
JWT_SECRET=alliance-ai-devcampus-secret-key-2026

# Google Gemini API Key (PRIMARY AI ENGINE - Google Technology)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional: Anthropic Claude API Key (Fallback AI Provider)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Database Connection (OPTIONAL)
# If PostgreSQL is not installed or unreachable, Alliance.ai automatically
# and smoothly activates its Resilient In-Memory Database pre-seeded with
# Alliance University courses, students, faculty, and past question papers.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/alliance_ai

# Maximum upload file size in megabytes
MAX_UPLOAD_MB=50
