# Copy this file to ".env" (same folder) and fill in your own values.
# The .env file is ignored by git, so your passwords and keys are never committed.

# PostgreSQL connection: postgres://USER:PASSWORD@HOST:PORT/DATABASE
# Use the password you chose when you installed PostgreSQL.
# "npm run db:setup" creates the alliance_ai database if it doesn't exist.
DATABASE_URL=postgres://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/alliance_ai

# Secret used to sign sign-in tokens. Any long random text; change it before deploying.
JWT_SECRET=change-this-to-a-long-random-string

# Largest file a user can upload, in MB.
MAX_UPLOAD_MB=50

# Get a key at https://console.anthropic.com  (API keys section).
# Without a key, Ask Alliance AI and 3D learning run in demo mode.
ANTHROPIC_API_KEY=

# Optional: which Claude model to use.
ANTHROPIC_MODEL=claude-sonnet-5-5

PORT=5000
