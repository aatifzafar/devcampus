  {
   "id": "th4",
   "code": "CSE301",
   "title": "Difference between wait() and sleep()?",
   "author": "Meera S",
   "at": "2026-10-29T11:30:00.000Z",
   "votes": 9,
   "mine": false,
   "body": "Both pause a thread. When should I use which?",
   "replies": [
    {
     "author": "Karthik R",
     "role": "student",
     "at": "2026-10-29T12:50:00.000Z",
     "votes": 5,
     "body": "sleep() pauses without releasing locks. wait() releases the monitor lock and waits for notify(). wait() must be called inside synchronized."
    }
   ]
  },
